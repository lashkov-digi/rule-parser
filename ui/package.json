{
  "name": "rule-parser-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "node ohm.ts && tsc --noEmit",
    "test": "vitest run",
    "test:parsers": "vitest run src/parsers",
    "bench": "vitest bench --run --reporter=default"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/common": "^1.5.3",
    "@lezer/lr": "^1.4.10",
    "ohm-js": "^17.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.1",
    "@ohm-js/cli": "^2.0.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
