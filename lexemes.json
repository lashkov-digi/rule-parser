    {
      "rule": "anchor",
      "text": "anchor \"IP Administration\": \"PK sampling\" 3x pre, post 1h 2h; \"Vital Signs\" 3x before \"PK sampling\"; \"12-lead ECG\" after \"Vital Signs\"",
      "tokens": [
