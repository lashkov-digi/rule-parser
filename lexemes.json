{
  "version": 1,
  "rules": [
    {
      "name": "subject",
      "startsWith": [
        "ACTIVITY"
      ],
      "description": "Activity header `\"Name\":`. Every statement after it belongs to that activity, until the next header."
    },
    {
      "name": "anchor",
      "startsWith": [
        "ANCHOR"
      ],
      "description": "Anchor header `anchor \"Name\":`. Every statement after it is a placement, until the next header."
    },
    {
      "name": "placement",
      "startsWith": [
        "ACTIVITY"
      ],
      "description": "Inside an anchor block only. Places the quoted activity: offsets from the block's anchor (`[COUNT] [EDGE] [OCCURRENCE] PRE/POST ...`, as in composite without `REL ACTIVITY`), or a dependency with explicit targets."
    },
    {
      "name": "count",
      "startsWith": [
        "COUNT"
      ],
      "description": "The activity runs N times a day, with no timing. Derivation places the occurrences."
    },
    {
      "name": "dependency",
      "startsWith": [
        "AFTER",
        "BEFORE",
        "COUNT"
      ],
      "description": "The activity runs after or before all listed activities, on every day they occur together. No time gap implied. An optional leading `COUNT` sets how many times it runs."
    },
    {
      "name": "fasting-wait",
      "startsWith": [
        "STATE"
      ],
      "description": "A fast or a wait of a set duration, before or after the activity."
    },
    {
      "name": "spacing",
      "startsWith": [
        "COUNT"
      ],
      "description": "The activity runs N times a day with a fixed gap between occurrences."
    },
    {
      "name": "composite",
      "startsWith": [
        "COUNT",
        "REL"
      ],
      "description": "The activity runs at offsets (pre, post N) from an anchor, each offset with an optional collection window."
    },
    {
      "name": "travel",
      "startsWith": [
        "TRAVEL"
      ],
      "description": "Travel of a set duration that arrives before an anchor, with an optional return."
    },
    {
      "name": "hospitalization",
      "startsWith": [
        "HOSP"
      ],
      "description": "The subject is hospitalized for N hours a day, starting at day start or at an activity."
    },
    {
      "name": "sequence",
      "startsWith": [
        "SEQUENCE"
      ],
      "description": "Legacy mode: a hand-built day written literally, one slot per statement in time order. Slots are `ACTIVITY DURATION`, `STATE DURATION` or `TRAVEL DURATION`. No rules, no derivation."
    }
  ],
  "tokens": [
    {
      "name": "COUNT",
      "kind": "literal",
      "lexemes": [],
      "pattern": "\\d+x",
      "rules": [
        "count",
        "dependency",
        "spacing",
        "composite",
        "placement"
      ],
      "description": "Occurrences per day, e.g. `3x`. Optional in dependency and composite; in composite the offsets define the count."
    },
    {
      "name": "DURATION",
      "kind": "literal",
      "lexemes": [],
      "pattern": "\\d+(\\.\\d+)?(min|m|h)",
      "rules": [
        "fasting-wait",
        "spacing",
        "composite",
        "travel",
        "hospitalization",
        "sequence",
        "placement"
      ],
      "description": "Time amount, e.g. `30m`, `90min`, `1.5h`. In hospitalization it is hours per day, from 1h to 24h; the parser checks the range, not the lexer."
    },
    {
      "name": "PERCENT",
      "kind": "literal",
      "lexemes": [],
      "pattern": "\\d+(\\.\\d+)?%",
      "rules": [
        "composite",
        "placement"
      ],
      "description": "Window as a percentage of the offset, e.g. `10%`."
    },
    {
      "name": "ACTIVITY",
      "kind": "string",
      "lexemes": [],
      "pattern": "\"[^\"]+\"",
      "rules": [
        "subject",
        "dependency",
        "composite",
        "travel",
        "hospitalization",
        "sequence",
        "anchor",
        "placement"
      ],
      "description": "Activity name in double quotes, e.g. `\"Chest X-ray\"`. No escapes in the POC."
    },
    {
      "name": "COLON",
      "kind": "separator",
      "lexemes": [
        {
          "value": ":",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "subject",
        "anchor"
      ],
      "description": "Ends a subject or anchor header."
    },
    {
      "name": "SEP",
      "kind": "separator",
      "lexemes": [
        {
          "value": ";",
          "aliases": []
        }
      ],
      "pattern": "\\r?\\n",
      "rules": [
        "subject",
        "count",
        "dependency",
        "fasting-wait",
        "spacing",
        "composite",
        "travel",
        "hospitalization",
        "sequence",
        "anchor",
        "placement"
      ],
      "description": "Ends a statement. Humans write newlines, machines write `;`. Repeated, leading and trailing separators are ignored, so blank lines are fine."
    },
    {
      "name": "COMMA",
      "kind": "separator",
      "lexemes": [
        {
          "value": ",",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "dependency",
        "composite",
        "placement"
      ],
      "description": "List separator."
    },
    {
      "name": "WINDOW",
      "kind": "operator",
      "lexemes": [
        {
          "value": "±",
          "aliases": [
            "+-"
          ]
        }
      ],
      "pattern": null,
      "rules": [
        "composite",
        "placement"
      ],
      "description": "Collection window for the offset right before it. Followed by `DURATION` or `PERCENT`. `+-` is the ASCII alias."
    },
    {
      "name": "DAY_ANCHOR",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "day-start",
          "aliases": []
        },
        {
          "value": "day-end",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "composite",
        "travel",
        "hospitalization"
      ],
      "description": "Start of the day (arrival on site) or end of the day. `day-end` is valid only in composite."
    },
    {
      "name": "BEFORE",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "before",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "dependency",
        "fasting-wait",
        "travel",
        "placement"
      ],
      "description": "Dependency: runs before. Fasting/wait: the slot comes before the activity. Travel: arrives before the anchor."
    },
    {
      "name": "AFTER",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "after",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "dependency",
        "fasting-wait",
        "placement"
      ],
      "description": "Dependency: runs after. Fasting/wait: the slot comes after the activity."
    },
    {
      "name": "STATE",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "fast",
          "aliases": []
        },
        {
          "value": "wait",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "fasting-wait",
        "sequence"
      ],
      "description": "Slot type. Starts a fasting or wait statement. In sequence mode, `STATE DURATION` is a fasting or wait slot."
    },
    {
      "name": "QUALIFIER",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "exactly",
          "aliases": [
            "="
          ]
        },
        {
          "value": "approximately",
          "aliases": [
            "approx",
            "~"
          ]
        },
        {
          "value": "atleast",
          "aliases": [
            ">="
          ]
        }
      ],
      "pattern": null,
      "rules": [
        "spacing"
      ],
      "description": "How strict the gap between occurrences is. Required."
    },
    {
      "name": "REL",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "rel",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "composite"
      ],
      "description": "\"Relative to\". Starts the anchor clause."
    },
    {
      "name": "EDGE",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "start",
          "aliases": []
        },
        {
          "value": "end",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "composite",
        "placement"
      ],
      "description": "Which end of the anchor activity the offsets are measured from. Optional, default `start`."
    },
    {
      "name": "OCCURRENCE",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "each",
          "aliases": []
        },
        {
          "value": "first",
          "aliases": []
        },
        {
          "value": "last",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "composite",
        "placement"
      ],
      "description": "Which occurrence of the anchor activity to use when it happens more than once that day. Optional, default `each`."
    },
    {
      "name": "PRE",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "pre",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "composite",
        "placement"
      ],
      "description": "An occurrence right before the anchor."
    },
    {
      "name": "POST",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "post",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "composite",
        "placement"
      ],
      "description": "Occurrences after the anchor. Followed by one or more `DURATION`, each with an optional `WINDOW`."
    },
    {
      "name": "TRAVEL",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "travel",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "travel",
        "sequence"
      ],
      "description": "Starts a travel statement. In sequence mode, `TRAVEL DURATION` is a travel slot."
    },
    {
      "name": "SEQUENCE",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "sequence",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "sequence"
      ],
      "description": "First token of a legacy text. Switches the parser to the sequence grammar for the whole text."
    },
    {
      "name": "ADMISSION",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "admission",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "travel"
      ],
      "description": "Hospital admission as the arrival anchor. Valid only on a day with hospitalization."
    },
    {
      "name": "RETURN",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "return",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "travel"
      ],
      "description": "Starts the optional return clause."
    },
    {
      "name": "RETURN_MODE",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "none",
          "aliases": []
        },
        {
          "value": "same",
          "aliases": []
        },
        {
          "value": "discharge",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "travel"
      ],
      "description": "`none`: no return travel. `same`: the same duration, after day end. `discharge`: after discharge. A `DURATION` in its place means a different return duration."
    },
    {
      "name": "HOSP",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "hosp",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "hospitalization"
      ],
      "description": "Starts a hospitalization statement."
    },
    {
      "name": "ANCHOR",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "anchor",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "anchor"
      ],
      "description": "Starts an anchor header. Followed by `ACTIVITY` and `COLON`."
    },
    {
      "name": "FROM",
      "kind": "keyword",
      "lexemes": [
        {
          "value": "from",
          "aliases": []
        }
      ],
      "pattern": null,
      "rules": [
        "hospitalization"
      ],
      "description": "Start point of the hospitalization. Optional, default `day-start`."
    }
  ],
  "examples": [
    {
      "rule": "dependency",
      "text": "after \"Vital Signs\", \"Chest X-ray\"",
      "tokens": [
        "AFTER",
        "ACTIVITY",
        "COMMA",
        "ACTIVITY"
      ]
    },
    {
      "rule": "dependency",
      "text": "before \"PK sampling\"",
      "tokens": [
        "BEFORE",
        "ACTIVITY"
      ]
    },
    {
      "rule": "dependency",
      "text": "3x before \"PK sampling\"",
      "tokens": [
        "COUNT",
        "BEFORE",
        "ACTIVITY"
      ]
    },
    {
      "rule": "count",
      "text": "3x",
      "tokens": [
        "COUNT"
      ]
    },
    {
